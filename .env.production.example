# Copy to .env.production.local for a local production build.
# For GitHub Pages Actions, use the repository variable LIKES_API_URL instead.
VITE_LIKES_API_URL=https://nsfz-photo-likes.YOUR_SUBDOMAIN.workers.dev/api/likes
# Enable these only after private R2 uploads and Turnstile are configured.
VITE_SUBMISSIONS_API_URL=https://nsfz-photo-likes.YOUR_SUBDOMAIN.workers.dev
VITE_TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
