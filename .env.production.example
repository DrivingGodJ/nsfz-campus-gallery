# Copy to .env.production.local for a local production build.
# For GitHub Pages Actions, use the repository variable LIKES_API_URL instead.
VITE_LIKES_API_URL=https://likes.drivinggodj.dpdns.org/api/likes
# Public image hosting; GitHub Pages uses the MEDIA_BASE_URL repository variable.
VITE_MEDIA_BASE_URL=https://photos.drivinggodj.dpdns.org/
# Public submissions are generated locally as ZIP packages and submitted by email.
# No submission service or Turnstile settings are required.
